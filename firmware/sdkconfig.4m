# 4 MB plain ESP32 (WROOM, NO PSRAM). Known-WORKING config (HW-confirmed JB of 12.00).
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4m.csv"
CONFIG_ESP32_SPIRAM_SUPPORT=n
# The PS5 rejects the TLS handshake flight when it is sent at full speed (-0x7780). mbedtls
# verbose logging paces the record writes enough for the console to accept them - it is the
# only config observed to complete the handshake reliably on this no-PSRAM esp32. The UART
# output is harmless (nothing reads it) and is the current working pacing mechanism.
# TODO: replace with a non-logging pace (a delay in the record-send path) once isolated.
CONFIG_MBEDTLS_DEBUG=y
CONFIG_MBEDTLS_DEBUG_LEVEL_VERBOSE=y
